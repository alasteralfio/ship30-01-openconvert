{
  "manifest_version": 3,
  "name": "OpenConvert",
  "version": "0.1.0",
  "description": "Open-source Chrome extension to convert currencies and auto-convert prices on any web page.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"]
    }
  ],
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://api.frankfurter.dev/*"
  ]
}
